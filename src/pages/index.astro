---
// The home page in the library style: the six themes as a colour mosaic, the
// featured rebuilt case on its colour field, the latest cases, and the method.
import { getCollection } from "astro:content";
import { load as parseYaml } from "js-yaml";
import LibraryLayout from "../layouts/LibraryLayout.astro";
import LibraryCard from "../components/LibraryCard.astro";
import { recordRoutes, recordedCaseIds } from "../record/lib/routes.mjs";
import { loadCase } from "../record/lib/record.mjs";
import { THEMES, themeOf } from "../record/subjects.mjs";

const cases = (await getCollection("cases", ({ data }) => ["published", "archived"].includes(data.status)))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const grades = new Set(cases.map((entry) => entry.data.evidence_grade)).size;
const rebuilt = recordedCaseIds();
const perTheme = Object.keys(THEMES).map((key) => ({ key, label: THEMES[key], count: cases.filter((e) => themeOf(e.data.case_id) === key).length }));

// Featured: a case rebuilt in the new format, opening on its story's first number.
const stories = import.meta.glob("../record/cases/*/story.yaml", { query: "?raw", import: "default", eager: true });
const featured = (await recordRoutes())
  .map(({ params, props }) => {
    const story = parseYaml(stories[`../record/cases/${props.code}/story.yaml`]);
    const id = loadCase(props.code).header.public_id;
    return { href: `${base}/cases/${params.year}/${params.case}/`, story, id, theme: themeOf(id) };
  })
  .at(-1);
---

<LibraryLayout>
  <div class="lb-wrap">
    <section class="hm-lead">
      <div>
        <p class="lb-kicker">An evidence-first collection</p>
        <h1>A reading room for applied intelligence</h1>
        <p class="lb-standfirst">Case studies of deployments, failures, economics, governance, and organizational change, written for people making real decisions.</p>
        <p class="hm-cta"><a href={`${base}/explore/`}>Explore all {cases.length} cases <span aria-hidden="true">→</span></a></p>
      </div>
      <nav class="hm-mosaic" aria-label="The library's six themes">
        {perTheme.map((t) => (
          <a class="hm-tile" data-subj={t.key} href={`${base}/explore/?theme=${t.key}`}>
            <span>{t.label}</span>
            <strong>{t.count}</strong>
            <small>{t.count === 1 ? "case" : "cases"}</small>
          </a>
        ))}
      </nav>
    </section>

    <section class="hm-stats" aria-label="The library in numbers">
      <div><strong>{cases.length}</strong><span>published {cases.length === 1 ? "case" : "cases"}</span></div>
      <div><strong>{rebuilt.size}</strong><span>rebuilt to the new standard, every sentence tied to its evidence</span></div>
      <div><strong>{grades}</strong><span>evidence {grades === 1 ? "grade" : "grades"} represented</span></div>
    </section>

    {featured && (
      <section>
        <div class="lb-sec-h"><h2>Featured case</h2><a href={featured.href}>Read the story</a></div>
        <a class="hm-feature" data-subj={featured.theme} href={featured.href}>
          <div class="hm-field">
            <p><span>{THEMES[featured.theme]}</span><span>Case {featured.id.slice(-3)}</span></p>
            <div><strong>{featured.story.numbers[0].figure}</strong><span>{featured.story.numbers[0].label}</span></div>
          </div>
          <div class="hm-feature-text">
            <p class="hm-feature-kicker">Grade {featured.story.grade.letter} · {featured.story.grade.plain}</p>
            <h3>{featured.story.headline}</h3>
            <p>{featured.story.dek}</p>
          </div>
        </a>
      </section>
    )}

    <section>
      <div class="lb-sec-h"><h2>Latest cases</h2><a href={`${base}/explore/`}>View all and filter</a></div>
      <div class="lb-cards">
        {cases.slice(0, 6).map((entry) => <LibraryCard entry={entry} rebuilt={rebuilt.has(entry.data.case_id)} />)}
      </div>
    </section>

    <section aria-labelledby="method-heading">
      <div class="lb-sec-h"><h2 id="method-heading">Built to be questioned</h2><a href={`${base}/methodology/`}>How the library works</a></div>
      <div class="hm-method">
        <div><em>1</em><strong>Traceable claims</strong><span>Material facts point to the evidence closest to the event, not an unattributed summary.</span></div>
        <div><em>2</em><strong>Calibrated conclusions</strong><span>Evidence grades and causal labels distinguish what happened from what the evidence can prove.</span></div>
        <div><em>3</em><strong>Open revision</strong><span>Verification dates, correction notes, and Git history make change visible.</span></div>
      </div>
    </section>
  </div>
</LibraryLayout>

<style is:global>
  .hm-lead { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; padding-block: 2.6rem 2.4rem; align-items: center; }
  .hm-lead h1 { font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1.04; letter-spacing: -.015em; font-variation-settings: "opsz" 72; margin: .8rem 0 1.2rem; }
  .hm-cta { margin: 1.6rem 0 0; }
  .hm-cta a { display: inline-block; background: var(--lb-ink); color: var(--lb-paper); text-decoration: none; font: 700 .9rem var(--lb-sans); padding: .8rem 1.1rem; }
  .hm-cta a:hover { background: var(--lb-ink-2); }
  .hm-mosaic { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 8rem; gap: 6px; }
  .hm-tile { background: var(--pop); color: var(--pop-on); padding: .8rem .9rem; display: grid; grid-template-rows: 1fr auto auto; text-decoration: none; min-width: 0; }
  .hm-tile span { font: 800 .66rem/1.35 var(--lb-sans); letter-spacing: .12em; text-transform: uppercase; }
  .hm-tile strong { font: 500 2.4rem/1 var(--lb-serif); font-variant-numeric: lining-nums; }
  .hm-tile small { font: 500 .78rem var(--lb-sans); opacity: .85; }
  .hm-tile:hover strong { text-decoration: underline; text-decoration-thickness: 2px; }

  .hm-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .hm-stats div { padding: 1rem 1.2rem; background: var(--lb-track); }
  .hm-stats strong { display: block; font: 500 2.2rem/1.1 var(--lb-serif); font-variant-numeric: lining-nums; }
  .hm-stats span { font: 500 .86rem/1.4 var(--lb-sans); color: var(--lb-ink-2); }

  .hm-feature { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); text-decoration: none; }
  .hm-field { background: var(--pop); color: var(--pop-on); padding: 1.5rem 1.7rem 1.7rem; display: grid; align-content: space-between; gap: 2rem; min-height: 17rem; }
  .hm-field p { margin: 0; display: flex; justify-content: space-between; gap: 1rem; font: 800 .74rem var(--lb-sans); letter-spacing: .14em; text-transform: uppercase; }
  .hm-field strong { display: block; font: 500 clamp(3.4rem, 8vw, 6.5rem)/.92 var(--lb-serif); font-variation-settings: "opsz" 72; letter-spacing: -.03em; font-variant-numeric: lining-nums; overflow-wrap: anywhere; }
  .hm-field div span { display: block; margin-top: .6rem; font: 500 1.05rem/1.35 var(--lb-serif); max-width: 22rem; }
  .hm-feature-text { padding: .4rem 0 0 2.4rem; display: grid; gap: .9rem; align-content: start; }
  .hm-feature-kicker { margin: 0; font: 800 .74rem var(--lb-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--pop-text); }
  .hm-feature h3 { font-size: clamp(1.6rem, 3vw, 2.3rem); line-height: 1.15; }
  .hm-feature:hover h3 { text-decoration: underline; text-decoration-color: var(--pop); text-decoration-thickness: 3px; }
  .hm-feature-text > p:last-child { margin: 0; color: var(--lb-ink-2); }

  .hm-method { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .hm-method div { background: var(--lb-ink); color: var(--lb-paper); padding: 1.2rem 1.3rem 1.3rem; display: flex; flex-direction: column; gap: .4rem; }
  .hm-method em { font: 500 1.6rem/1 var(--lb-serif); font-style: normal; opacity: .6; }
  .hm-method strong { font: 500 1.35rem/1.2 var(--lb-serif); }
  .hm-method span { font: 400 .95rem/1.5 var(--lb-sans); opacity: .85; }

  @media (max-width: 920px) {
    .hm-lead, .hm-feature { grid-template-columns: 1fr; }
    .hm-feature-text { padding: 1.4rem 0 0; }
    .hm-field { min-height: 0; }
    .hm-method { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .hm-stats { grid-template-columns: 1fr; }
    .hm-mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 7rem; }
  }
</style>
