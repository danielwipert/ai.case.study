---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseCard from "../components/CaseCard.astro";

const cases = (await getCollection("cases", ({ data }) => ["published", "archived"].includes(data.status)))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const grades = new Set(cases.map((entry) => entry.data.evidence_grade)).size;
---

<BaseLayout>
  <section class="shell hero">
    <div>
      <p class="eyebrow">Evidence over excitement</p>
      <h1>AI, where it meets <em>reality.</em></h1>
    </div>
    <div class="hero-copy">
      <p>Case studies of deployments, failures, economics, governance, and organizational change—written for people making real decisions.</p>
      <a class="button" href={`${base}/explore/`}>Explore the library →</a>
    </div>
  </section>

  <div class="signal-bar">
    <div class="shell signals">
      <div class="signal"><strong>{cases.length}</strong><span>published {cases.length === 1 ? "case" : "cases"}</span></div>
      <div class="signal"><strong>{grades}</strong><span>evidence {grades === 1 ? "grade" : "grades"} represented</span></div>
      <div class="signal"><strong>Open</strong><span>methods, citations, and revision history</span></div>
    </div>
  </div>

  <section class="shell section">
    <div class="section-head">
      <h2>Latest cases</h2>
      <a href={`${base}/explore/`}>View all and filter →</a>
    </div>
    <div class="case-grid">
      {cases.slice(0, 4).map((entry) => <CaseCard entry={entry} />)}
    </div>
  </section>

  <section class="shell section" aria-labelledby="method-heading">
    <div class="section-head"><h2 id="method-heading">Built to be questioned</h2></div>
    <div class="principles">
      <div class="principle"><span class="number">01</span><h3>Traceable claims</h3><p>Material facts point to the evidence closest to the event, not an unattributed summary.</p></div>
      <div class="principle"><span class="number">02</span><h3>Calibrated conclusions</h3><p>Evidence grades and causal labels distinguish what happened from what the evidence can prove.</p></div>
      <div class="principle"><span class="number">03</span><h3>Open revision</h3><p>Verification dates, correction notes, and Git history make change visible.</p></div>
    </div>
  </section>
</BaseLayout>
