---
import { getCollection, render } from "astro:content";
import MagazineLayout from "../layouts/MagazineLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const cases = await getCollection("cases", ({ data }) => ["published", "archived"].includes(data.status));
const byId = new Map(cases.map((entry) => [entry.data.case_id, entry]));

const propositions = (await getCollection("propositions")).sort((a, b) => a.data.order - b.data.order);
const tensions = (await getCollection("tensions")).sort((a, b) => a.data.order - b.data.order);

// Every figure on this page is computed from the case records at build time, so
// adding or regrading a case moves the page without anyone remembering to.
const outcomes = ["positive", "mixed", "inconclusive", "negative", "unknown"];
const grades = ["A", "B", "C"];
const matrix = grades.map((grade) => ({
  grade,
  cells: outcomes.map((outcome) => ({
    outcome,
    n: cases.filter((entry) => entry.data.evidence_grade === grade && entry.data.outcome === outcome).length
  }))
}));
// The finding P1 rests on: the region of the matrix that is empty.
const positiveHighGrade = matrix
  .filter((row) => row.grade === "A")
  .flatMap((row) => row.cells.filter((cell) => cell.outcome === "positive"));
const p1Holds = positiveHighGrade.every((cell) => cell.n === 0);

const uniqueCount = (values) => new Set(values.filter(Boolean)).size;
const stats = {
  cases: cases.length,
  industries: uniqueCount(cases.flatMap((entry) => entry.data.industry)),
  geographies: uniqueCount(cases.flatMap((entry) => entry.data.geography)),
  patterns: uniqueCount(cases.flatMap((entry) => entry.data.deployment_pattern))
};

const lastReviewed = [...propositions, ...tensions]
  .map((entry) => entry.data.last_reviewed)
  .sort((a, b) => b.valueOf() - a.valueOf())[0];
const longDate = (value) =>
  value?.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }) ?? "";

// Strength definitions are the validator's rules restated for the reader. If the
// two ever disagree, the build is the one telling the truth.
const strengthNotes = [
  { key: "recurrent", note: "Three or more cases, in at least two industries, with at least one graded A or B. Strong enough to plan against." },
  { key: "emerging", note: "Two or three cases. The pattern is real in the record and the record is thin. Strong enough to watch for." },
  { key: "conjecture", note: "Resting on grade C cases, on self-reported evidence, or on how this library was assembled. Strong enough to argue about." }
];

const bodies = new Map();
for (const entry of [...propositions, ...tensions]) {
  const { Content } = await render(entry);
  bodies.set(entry.id, Content);
}

const chipFor = (id) => {
  const entry = byId.get(id);
  if (!entry) return null;
  return {
    id,
    number: id.split("-").pop(),
    grade: entry.data.evidence_grade,
    organization: entry.data.organization[0],
    title: entry.data.title,
    href: `${base}/cases/${entry.id}/`
  };
};
---

<MagazineLayout
  title="Propositions | Applied AI Case Study Library"
  description="Claims that hold across more than one case in the library, each with its supporting cases, their evidence grades, and the finding that would break it."
  active="propositions"
>
  <section class="mg-hero mg-hero-page" slot="hero">
   <div class="mg-wrap">
    <p class="mg-tags"><span>Cross-case synthesis</span></p>
    <h1>Propositions</h1>
    <p class="mg-dek">
      Claims that hold across more than one case in this library, each with the cases underneath it, the evidence grade
      of each, and the finding that would break it. A proposition is a standing invitation to be proved wrong, not a
      conclusion.
    </p>
    <p class="mg-hero-meta">
      Derived from {stats.cases} published cases across {stats.industries} industries, {stats.geographies} countries
      and {stats.patterns} deployment patterns. Recomputed at every build; last editorial review {longDate(lastReviewed)}.
    </p>
   </div>
  </section>

  <section class="mg-wrap mg-sec contract">
    <h2 class="mg-h"><span>01</span>How to read a proposition</h2>
    <div class="contract-grid">
      {strengthNotes.map(({ key, note }) => (
        <div>
          <h3><span class="strength" data-s={key}>{key}</span></h3>
          <p>{note}</p>
        </div>
      ))}
    </div>
    <p class="rule-note">
      <strong>A proposition can never outrank the cases beneath it.</strong> Case claims carry their own labels —
      Verified, Supported, Attributed, Disputed, Inference, Unknown — and a proposition does not upgrade them by counting
      them. These strength rules are enforced by the content validator, so a label that has outgrown its evidence fails
      the build rather than reaching this page.
    </p>
  </section>

  <section class="mg-wrap mg-sec">
    <ol class="props">
      {propositions.map((entry) => {
        const Body = bodies.get(entry.id);
        const supporting = entry.data.supporting_cases.map(chipFor).filter(Boolean);
        const counter = entry.data.counter_cases.map(chipFor).filter(Boolean);
        const lead = supporting.map((chip) => chip.grade).sort()[0] ?? "C";
        const isP1 = entry.data.proposition_id === "P1";
        return (
          <li class:list={["prop", { feature: isP1 }]} data-lead={lead} id={entry.data.proposition_id}>
            <div class="prop-head">
              <a class="pid" href={`#${entry.data.proposition_id}`}>{entry.data.proposition_id}</a>
              <h2>{entry.data.statement}</h2>
              <span class="strength" data-s={entry.data.strength}>{entry.data.strength}</span>
              {entry.data.scope === "library" && <span class="scope">About the library</span>}
            </div>

            <div class="prop-body"><Body /></div>

            {isP1 && (
              <figure class="matrix-wrap">
                <figcaption>Evidence grade × reported outcome, {stats.cases} published cases</figcaption>
                <table class="matrix">
                  <thead>
                    <tr>
                      <th scope="col">Grade</th>
                      {outcomes.map((outcome) => <th scope="col">{outcome}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {matrix.map((row) => (
                      <tr data-grade={row.grade}>
                        <th scope="row">{row.grade}</th>
                        {row.cells.map((cell) => (
                          <td
                            class:list={[
                              cell.n === 0 ? "zero" : "n",
                              { gap: p1Holds && row.grade === "A" && cell.outcome === "positive" }
                            ]}
                          >{cell.n === 0 ? "—" : cell.n}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="matrix-key">
                  <span aria-hidden="true"></span>
                  {p1Holds
                    ? "The empty cell that carries the finding. No case graded A reports a positive outcome."
                    : "A grade A case now reports a positive outcome, and this proposition needs rewriting."}
                </p>
              </figure>
            )}

            <p class="operator">
              <strong>What an operator should take from it</strong>
              {entry.data.operator_takeaway}
            </p>

            <div class="ledger">
              <section>
                <h3>Support</h3>
                <ul class="cases">
                  {supporting.map((chip) => (
                    <li>
                      <a class="chip" data-grade={chip.grade} href={chip.href} title={chip.title}>
                        <b>{chip.grade}</b><span>{chip.number} · {chip.organization}</span>
                      </a>
                    </li>
                  ))}
                  {counter.map((chip) => (
                    <li>
                      <a class="chip counter" data-grade={chip.grade} href={chip.href} title={chip.title}>
                        <b>{chip.grade}</b><span>{chip.number} · {chip.organization} — counter</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
              <section>
                <h3>What would break it</h3>
                <p>{entry.data.falsifier}</p>
              </section>
              <section>
                <h3>Where it strains</h3>
                <p>{entry.data.limits}</p>
              </section>
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="disagree">
   <div class="mg-wrap">
    <h2 class="mg-h mg-h-inv"><span>02</span>Where the library disagrees with itself</h2>
    <p class="mg-lede">
      A synthesis that only finds agreement is not reading carefully. These are the places where the record points in
      two directions, kept on the page rather than dropped from it.
    </p>
    <div class="pairs">
      {tensions.map((entry) => {
        const Body = bodies.get(entry.id);
        const chips = entry.data.cases.map(chipFor).filter(Boolean);
        return (
          <article id={entry.data.tension_id}>
            <h3>{entry.data.title}</h3>
            <Body />
            <ul class="cases">
              {chips.map((chip) => (
                <li>
                  <a class="chip" data-grade={chip.grade} href={chip.href} title={chip.title}>
                    <b>{chip.grade}</b><span>{chip.number} · {chip.organization}</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>
   </div>
  </section>
</MagazineLayout>

<style is:global>
  .mg-hero-page { padding: 4.2rem 0 3.4rem; }
  .mg-hero-meta { margin: 2rem 0 0; padding-top: 1rem; border-top: 1px solid #333; max-width: 52rem; font: 700 .72rem/1.6 var(--mg-sans); letter-spacing: .12em; text-transform: uppercase; color: #9a9aa0; }
  .mg-lede { font: 400 1.15rem/1.55 var(--mg-serif); color: #b8b8bd; max-width: 46rem; margin: 0 0 2.5rem; }

  .contract-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .contract-grid > div { border: 2px solid var(--mg-ink); padding: 1.4rem; }
  .contract-grid h3 { margin: 0 0 .8rem; }
  .contract-grid p { margin: 0; font: 400 1rem/1.55 var(--mg-serif); }
  .rule-note { margin: 1.6rem 0 0; padding: 1.2rem 1.4rem; background: var(--mg-lime); font: 400 1.05rem/1.55 var(--mg-serif); max-width: 60rem; }
  .rule-note strong { font-weight: 600; }

  .strength { display: inline-block; font: 800 .68rem var(--mg-sans); letter-spacing: .14em; text-transform: uppercase; padding: .3rem .55rem; border: 2px solid var(--mg-ink); }
  .strength[data-s="recurrent"] { background: var(--mg-ink); color: #fff; }
  .strength[data-s="emerging"] { background: var(--mg-violet); border-color: var(--mg-violet); color: #fff; }
  .strength[data-s="conjecture"] { border-style: dashed; color: var(--mg-ink); }
  .scope { font: 800 .66rem var(--mg-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--mg-grey); }

  .props { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4rem; }
  .prop { border-top: 6px solid var(--mg-ink); padding-top: 1.4rem; scroll-margin-top: 1rem; }
  .prop.feature { background: var(--mg-soft); border-top-color: var(--mg-pink); padding: 1.6rem 1.8rem 1.8rem; }
  .prop-head { display: flex; align-items: baseline; gap: .6rem 1.2rem; flex-wrap: wrap; margin-bottom: 1.4rem; }
  .prop-head .pid { font: 400 2.6rem/1 var(--mg-display); letter-spacing: -.04em; color: var(--mg-violet); text-decoration: none; }
  .prop-head h2 { flex: 1 1 24ch; margin: 0; font: 400 clamp(1.5rem, 2.8vw, 2.1rem)/1.1 var(--mg-display); letter-spacing: -.025em; text-wrap: balance; }
  .prop-body { max-width: 46rem; font: 400 1.15rem/1.65 var(--mg-serif); }
  .prop-body p { margin: 0 0 1rem; }
  .prop-body p:last-child { margin-bottom: 0; }

  .matrix-wrap { margin: 1.8rem 0; overflow-x: auto; }
  .matrix-wrap figcaption { font: 800 .7rem var(--mg-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--mg-grey); margin-bottom: .7rem; }
  table.matrix { border-collapse: collapse; min-width: 30rem; font: 500 1rem var(--mg-sans); font-variant-numeric: tabular-nums; background: #fff; }
  table.matrix th, table.matrix td { border: 1px solid #ccc; padding: .65rem .9rem; text-align: center; }
  table.matrix thead th { background: var(--mg-ink); color: #fff; border-color: var(--mg-ink); font: 800 .66rem var(--mg-sans); letter-spacing: .12em; text-transform: uppercase; }
  table.matrix tbody th { font: 400 1.1rem var(--mg-display); }
  table.matrix td.zero { color: #aaa; }
  table.matrix td.n { font: 400 1.15rem var(--mg-display); }
  table.matrix td.gap { background: var(--mg-pink); color: var(--mg-ink); outline: 3px solid var(--mg-ink); outline-offset: -3px; }
  .matrix-key { display: flex; gap: .6rem; align-items: center; margin: .8rem 0 0; font: 500 .92rem var(--mg-sans); }
  .matrix-key span { width: 1rem; height: 1rem; background: var(--mg-pink); outline: 2px solid var(--mg-ink); flex: none; }

  .operator { margin: 1.8rem 0 0; padding: 1.3rem 1.5rem; background: var(--mg-violet); color: #fff; max-width: 52rem; font: 400 1.08rem/1.55 var(--mg-serif); }
  .operator strong { display: block; margin-bottom: .45rem; font: 800 .7rem var(--mg-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--mg-lime); }

  .ledger { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.6rem 2.2rem; margin-top: 1.8rem; padding-top: 1.4rem; border-top: 1px solid #ddd; }
  .ledger h3 { margin: 0 0 .7rem; font: 800 .7rem var(--mg-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--mg-pink); }
  .ledger p { margin: 0; font: 400 1rem/1.55 var(--mg-serif); }

  .cases { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .45rem; }
  .cases li { max-width: 100%; min-width: 0; }
  .chip { display: inline-flex; align-items: stretch; max-width: 100%; text-decoration: none; border: 2px solid var(--mg-ink); background: #fff; color: var(--mg-ink) !important; font: 700 .74rem var(--mg-sans); }
  .chip b { display: grid; place-items: center; min-width: 1.6rem; background: var(--mg-ink); color: #fff; font: 400 .85rem var(--mg-display); }
  .chip[data-grade="A"] b { background: var(--mg-ink); }
  .chip[data-grade="B"] b { background: var(--mg-violet); }
  .chip[data-grade="C"] b { background: var(--mg-pink); color: var(--mg-ink); }
  .chip span { padding: .35rem .55rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .chip:hover { background: var(--mg-lime); }
  .chip.counter { border-style: dashed; }

  .disagree { background: var(--mg-ink); color: #fff; margin-top: 4.5rem; padding: 4rem 0 4.5rem; }
  .pairs { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; }
  .pairs article { border: 2px solid #fff; padding: 1.6rem; font: 400 1.02rem/1.6 var(--mg-serif); color: #e4e4e7; }
  .pairs h3 { margin: 0 0 .9rem; font: 400 1.5rem/1.1 var(--mg-display); letter-spacing: -.02em; color: #fff; }
  .pairs article p { margin: 0 0 1rem; }
  .pairs .cases { margin-top: 1rem; }

  @media (max-width: 860px) {
    .contract-grid, .ledger { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 600px) {
    .prop.feature { padding: 1.2rem 1rem 1.4rem; }
    .prop-head .pid { font-size: 2rem; }
  }
</style>
