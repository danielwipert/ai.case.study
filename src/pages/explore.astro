---
import { getCollection } from "astro:content";
import LibraryLayout from "../layouts/LibraryLayout.astro";
import LibraryCard from "../components/LibraryCard.astro";
import { recordedCaseIds } from "../record/lib/routes.mjs";
import { THEMES } from "../record/subjects.mjs";

const cases = (await getCollection("cases", ({ data }) => ["published", "archived"].includes(data.status)))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const unique = (values) => [...new Set(values)].sort();
const industries = unique(cases.flatMap((entry) => entry.data.industry));
const functions = unique(cases.flatMap((entry) => entry.data.business_function));
const types = unique(cases.map((entry) => entry.data.case_type));
const outcomes = unique(cases.map((entry) => entry.data.outcome));
const grades = unique(cases.map((entry) => entry.data.evidence_grade));
const rebuilt = recordedCaseIds();
---

<LibraryLayout title="Explore cases | Applied AI Case Study Library" active="explore">
  <div class="lb-wrap">
    <div class="lb-pagehead">
      <p class="lb-kicker">The library</p>
      <h1>Explore cases</h1>
      <p class="lb-standfirst">Search by organization or subject, then narrow the record by theme, industry, business function, case type, outcome, or evidence grade.</p>
    </div>
  </div>

  <section class="ex-filters-band">
    <div class="lb-wrap">
      <div class="ex-filters" aria-label="Case filters">
        <label class="ex-search">Search<input id="search" type="search" placeholder="Organization, subject, or tag" /></label>
        <label>Theme<select id="theme"><option value="">All</option>{Object.entries(THEMES).map(([k, v]) => <option value={k}>{v}</option>)}</select></label>
        <label>Industry<select id="industry"><option value="">All</option>{industries.map((v) => <option value={v}>{v.replaceAll("-", " ")}</option>)}</select></label>
        <label>Function<select id="function"><option value="">All</option>{functions.map((v) => <option value={v}>{v.replaceAll("-", " ")}</option>)}</select></label>
        <label>Case type<select id="case-type"><option value="">All</option>{types.map((v) => <option value={v}>{v.replaceAll("-", " ")}</option>)}</select></label>
        <label>Outcome<select id="outcome"><option value="">All</option>{outcomes.map((v) => <option value={v}>{v}</option>)}</select></label>
        <label>Evidence<select id="grade"><option value="">All</option>{grades.map((v) => <option value={v}>Grade {v}</option>)}</select></label>
      </div>
    </div>
  </section>

  <section class="lb-wrap ex-results">
    <p class="ex-status" id="result-status" aria-live="polite">Showing {cases.length} {cases.length === 1 ? "case" : "cases"}</p>
    <div class="lb-cards" id="results">
      {cases.map((entry) => <LibraryCard entry={entry} rebuilt={rebuilt.has(entry.data.case_id)} />)}
    </div>
    <p class="ex-empty" id="empty" hidden>No cases match those filters. Try broadening the search.</p>
  </section>

  <script>
    const controls = {
      search: document.querySelector("#search"),
      theme: document.querySelector("#theme"),
      industry: document.querySelector("#industry"),
      function: document.querySelector("#function"),
      caseType: document.querySelector("#case-type"),
      outcome: document.querySelector("#outcome"),
      grade: document.querySelector("#grade")
    };
    const cards = [...document.querySelectorAll("[data-card]")];
    const status = document.querySelector("#result-status");
    const empty = document.querySelector("#empty");

    function filterCases() {
      const query = controls.search.value.trim().toLowerCase();
      let count = 0;
      cards.forEach((card) => {
        const visible = (!query || card.dataset.search.includes(query))
          && (!controls.theme.value || card.dataset.theme === controls.theme.value)
          && (!controls.industry.value || card.dataset.industry.split(" ").includes(controls.industry.value))
          && (!controls.function.value || card.dataset.function.split(" ").includes(controls.function.value))
          && (!controls.caseType.value || card.dataset.caseType === controls.caseType.value)
          && (!controls.outcome.value || card.dataset.outcome === controls.outcome.value)
          && (!controls.grade.value || card.dataset.grade === controls.grade.value);
        card.hidden = !visible;
        if (visible) count += 1;
      });
      status.textContent = `Showing ${count} ${count === 1 ? "case" : "cases"}`;
      empty.hidden = count !== 0;
    }
    Object.values(controls).forEach((control) => control.addEventListener("input", filterCases));
    // The home page's theme tiles link here as ?theme=<key>.
    const wanted = new URLSearchParams(location.search).get("theme");
    if (wanted && [...controls.theme.options].some((o) => o.value === wanted)) {
      controls.theme.value = wanted;
      filterCases();
    }
  </script>
</LibraryLayout>

<style is:global>
  .ex-filters-band { background: var(--lb-track); padding: 1.2rem 0; position: sticky; top: 0; z-index: 5; border-block: 1px solid var(--lb-rule); }
  .ex-filters { display: grid; grid-template-columns: 2fr repeat(6, minmax(0, 1fr)); gap: .8rem; align-items: end; }
  .ex-filters label { display: flex; flex-direction: column; gap: .35rem; font: 700 .66rem var(--lb-sans); letter-spacing: .12em; text-transform: uppercase; color: var(--lb-ink-2); min-width: 0; }
  .ex-filters input, .ex-filters select { width: 100%; box-sizing: border-box; height: 2.6rem; padding: 0 .7rem; border: 1px solid var(--lb-ink-3); border-radius: 0; background: var(--lb-paper); color: var(--lb-ink); font: 500 .92rem var(--lb-sans); text-transform: none; letter-spacing: 0; }
  .ex-filters select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--lb-ink) 50%), linear-gradient(135deg, var(--lb-ink) 50%, transparent 50%); background-position: calc(100% - 16px) 50%, calc(100% - 11px) 50%; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 1.8rem; text-transform: capitalize; }
  .ex-filters input:focus, .ex-filters select:focus { outline: 2px solid var(--lb-ink); outline-offset: 1px; }
  .ex-results { padding-top: 2rem; }
  .ex-status { margin: 0 0 1.4rem; font: 700 .74rem var(--lb-sans); letter-spacing: .12em; text-transform: uppercase; color: var(--lb-ink-2); }
  .ex-empty { margin: 2rem 0; padding: 1.4rem; background: var(--lb-track); font: 500 1.4rem/1.3 var(--lb-serif); }

  @media (max-width: 1000px) {
    .ex-filters { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ex-search { grid-column: 1 / -1; }
  }
  @media (max-width: 600px) {
    .ex-filters-band { position: static; }
    .ex-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; }
  }
</style>
