---
// The reader layer ("the story"), magazine design. Plain English;
// every statement tied to checked rows; technical detail one and two clicks down.
import "@fontsource/archivo-black/400.css";
import "@fontsource/archivo/500.css";
import "@fontsource/archivo/700.css";
import "@fontsource/archivo/800.css";
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/400-italic.css";
import "@fontsource/source-serif-4/600.css";
import { load as parseYaml } from "js-yaml";
import { loadCase, shortCode } from "../../../../record/lib/record.mjs";
import { recordRoutes } from "../../../../record/lib/routes.mjs";

export function getStaticPaths() {
  return recordRoutes();
}

const stories = import.meta.glob("../../../../record/cases/*/story.yaml", { query: "?raw", import: "default", eager: true });
const code = Astro.props.code;
const story = parseYaml(stories[`../../../../record/cases/${code}/story.yaml`]);
const record = loadCase(code);
const byShort = new Map(record.rows.map((r) => [shortCode(r.code), r]));
for (const list of [[story.grade], ...(story.dek_rows ? [[{ rows: story.dek_rows }]] : []), story.short_version, story.numbers, story.timeline, story.what_they_say, story.unknowns, ...(story.disagreements ?? []).map((d) => [...d.sides, ...(d.note ? [d.note] : [])])])
  for (const item of list) for (const r of item.rows) if (!byShort.has(r)) throw new Error(`story.yaml cites ${r}, which is not a live row`);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const root = `${base}/cases/${Astro.params.year}/${Astro.params.case}`;
const tip = (rows) => rows.map((r) => `${r}: ${byShort.get(r).statement} [${byShort.get(r).label.display}]`).join("\n\n");
const src = (rows) => `${root}/evidence/#${rows[0]}`;
const docs = record.documents.length;
const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;
// Section numbers follow the sections a story actually has.
const order = ["short", "timeline", ...(story.disagreements?.length ? ["disagree"] : []), "quotes", "unknowns", "deeper"];
const num = (key) => pad(order.indexOf(key) + 1);
const pad = (n) => String(n).padStart(2, "0");

// Timeline marks: an entry may name a `mark` from `timeline_key`, which gives it a colour and a legend line.
// Colour follows the event, never its position in the list.
const MARK_COLORS = new Set(["pink", "violet", "grey", "ink"]);
const key = story.timeline_key ?? [];
for (const k of key) if (!MARK_COLORS.has(k.color)) throw new Error(`timeline_key colour "${k.color}" is not one of ${[...MARK_COLORS].join(", ")}`);
const markColor = new Map(key.map((k) => [k.mark, k.color]));
for (const t of story.timeline) if (t.mark && !markColor.has(t.mark)) throw new Error(`timeline mark "${t.mark}" is not in timeline_key`);
const colorOf = (t) => (t.mark ? markColor.get(t.mark) : null);

// Timeline to scale: parse "8 Jul", "Sep 2024" or "6 Apr 2026". A date without a year takes the previous
// entry's year (or the story's), moving to the next year if the month goes backwards.
// Any date that does not parse turns the scaling off and the list renders as before.
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const DAY = 86400000;
const storyYear = Number(`${story.tags.join(" ")} ${story.checked}`.match(/\b(?:19|20)\d{2}\b/)?.[0] ?? new Date().getFullYear());
const parsed = (() => {
  let year = null, month = null;
  const out = [];
  for (const t of story.timeline) {
    const m = String(t.date).trim().match(/^(?:(\d{1,2}) )?([A-Z][a-z]{2})[a-z]* ?(\d{4})?$/);
    if (!m || !MONTHS.includes(m[2])) return null;
    const mo = MONTHS.indexOf(m[2]);
    const y = m[3] ? Number(m[3]) : year === null ? storyYear : year + (mo < month ? 1 : 0);
    year = y; month = mo;
    out.push({ day: m[1] ? Number(m[1]) : null, month: mo, year: y, ms: Date.UTC(y, mo, m[1] ? Number(m[1]) : 1) });
  }
  return out;
})();
const gaps = parsed ? parsed.map((d, i) => {
  if (i === 0) return null;
  const p = parsed[i - 1];
  if (d.day !== null && p.day !== null) {
    const days = Math.round((d.ms - p.ms) / DAY);
    return { approxDays: days, text: days === 0 ? "Same day" : days === 1 ? "Next day" : `${days} days` };
  }
  const months = (d.year - p.year) * 12 + d.month - p.month;
  return { approxDays: months * 30.4, text: months === 0 ? "Same month" : months === 1 ? "1 month" : `${months} months` };
}) : [];
// A gap far longer than the typical one is drawn as a break; the rest get space in proportion to their length.
const spans = gaps.filter(Boolean).map((g) => g.approxDays).sort((a, b) => a - b);
const median = spans.length ? (spans[(spans.length - 1) >> 1] + spans[spans.length >> 1]) / 2 : 0;
const isBreak = (g) => g && g.approxDays > 14 && g.approxDays > 4 * median;
const longest = Math.max(1, ...gaps.filter((g) => g && !isBreak(g)).map((g) => g.approxDays));
const gapPad = (g) => `${(0.6 + 1.2 * (g.approxDays / longest)).toFixed(2)}rem`;

// The calendar strip: one square per day, drawn only for short, day-precise timelines (a month of days or less, breaks aside).
const strip = (() => {
  if (!parsed || parsed.some((d) => d.day === null)) return null;
  const segments = [];
  parsed.forEach((d, i) => {
    if (i === 0 || isBreak(gaps[i])) segments.push({ from: d.ms, to: d.ms, gap: i === 0 ? null : gaps[i].text });
    else segments[segments.length - 1].to = d.ms;
  });
  const cells = segments.reduce((n, s) => n + (s.to - s.from) / DAY + 1, 0);
  if (cells > 31) return null;
  const byDay = new Map();
  parsed.forEach((d, i) => { if (!byDay.has(d.ms) || colorOf(story.timeline[i])) byDay.set(d.ms, colorOf(story.timeline[i]) ?? "ink"); });
  return segments.map((s) => ({
    gap: s.gap,
    days: Array.from({ length: (s.to - s.from) / DAY + 1 }, (_, k) => {
      const ms = s.from + k * DAY, dt = new Date(ms);
      return { label: k === 0 ? `${dt.getUTCDate()} ${MONTHS[dt.getUTCMonth()]}` : String(dt.getUTCDate()), color: byDay.get(ms) ?? null };
    }),
  }));
})();
const first = story.timeline[0].date, last = story.timeline[story.timeline.length - 1].date;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={story.dek} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <title>{story.headline} | Applied AI Case Study Library</title>
</head>
<body class="mg">
  <header class="mg-top">
    <a class="mg-brand" href={`${base}/`}><b>Applied AI</b><span>Case Study Library</span></a>
    <nav class="mg-tabs" aria-label="Layers of this case">
      <a aria-current="page" href={`${root}/`}>The story</a>
      <a href={`${root}/record/`}>Full record</a>
      <a href={`${root}/evidence/`}>Evidence</a>
      <a href={`${root}/sources/`}>Sources</a>
    </nav>
  </header>

  <section class="mg-hero">
    <div class="mg-wrap mg-hero-grid">
      <div>
        <p class="mg-tags">{story.tags.map((tag) => <span>{tag}</span>)}</p>
        <h1>{story.headline}</h1>
        <p class="mg-dek">{story.dek}</p>
      </div>
      <aside class="mg-stamp" aria-label={`Case grade ${story.grade.letter}: ${story.grade.plain}`}>
        <span class="mg-stamp-letter">{story.grade.letter}</span>
        <span class="mg-stamp-word">{story.grade.plain}</span>
        <p>{story.grade.explain}</p>
      </aside>
    </div>
    <div class="mg-wrap"><p class="mg-meta">{plural(docs, "public source", "public sources")} · every statement linked to its evidence · {story.checked}</p></div>
  </section>

  <main>
    <section class="mg-wrap mg-sec">
      <h2 class="mg-h"><span>{num("short")}</span>The short version</h2>
      <ol class="mg-points">
        {story.short_version.map((p, i) => (
          <li><span class="mg-pn">{pad(i + 1)}</span><p>{p.text} <a class="mg-src" href={src(p.rows)} title={tip(p.rows)}>Source</a></p></li>
        ))}
      </ol>
    </section>

    <section class="mg-numbers" aria-label="Key numbers">
      <div class="mg-wrap mg-num-grid">
        {story.numbers.map((n) => (
          <div class="mg-num"><strong>{n.figure}</strong><span>{n.label}</span><p class="mg-num-src">{n.by && `Counted by ${n.by} · `}<a class="mg-src" href={src(n.rows)} title={tip(n.rows)}>Source</a></p></div>
        ))}
      </div>
    </section>

    <section class="mg-wrap mg-sec">
      <h2 class="mg-h"><span>{num("timeline")}</span>{story.timeline_title ?? "Day by day"}</h2>
      {strip && (
        <div class="mg-strip-wrap" role="img" aria-label={`Calendar from ${first} to ${last}, one square per day. Filled squares are the days in the list below.`}>
          <div class="mg-strip">
            {strip.map((seg) => (<>
              {seg.gap && <div class="mg-day mg-day-gap">{seg.gap}</div>}
              {seg.days.map((d) => <div class={`mg-day${d.color ? ` mg-c-${d.color}` : ""}`}>{d.label}<i></i></div>)}
            </>))}
          </div>
        </div>
      )}
      {key.length > 0 && (
        <ul class="mg-key">{key.map((k) => <li><i class={`mg-c-${k.color}`}></i>{k.label}</li>)}</ul>
      )}
      <ol class="mg-tl">
        {story.timeline.map((t, i) => (
          <li class={colorOf(t) ? `mg-c-${colorOf(t)}` : undefined}>
            {gaps[i] && (isBreak(gaps[i])
              ? <p class="mg-gap mg-gap-break" aria-hidden="true">{gaps[i].text}</p>
              : <p class="mg-gap" style={`padding-block: ${gapPad(gaps[i])}`} aria-hidden="true">{gaps[i].text}</p>)}
            <time>{t.date}</time><p>{t.text} <a class="mg-src" href={src(t.rows)} title={tip(t.rows)}>Source</a></p>
          </li>
        ))}
      </ol>
    </section>

    {story.disagreements?.length > 0 && <section class="mg-split-sec">
      <div class="mg-wrap">
        <h2 class="mg-h mg-h-inv"><span>{num("disagree")}</span>{story.disagreements_title ?? "Where the accounts disagree"}</h2>
        <p class="mg-lede">{story.disagreements_lede ?? "Both sides, side by side. We don't pick one: the public record doesn't settle it."}</p>
      </div>
      {story.disagreements.map((d) => (
        <div class="mg-wrap mg-dispute">
          <h3>{d.title}</h3>
          <div class="mg-sides">
            <div class="mg-side"><p class="mg-who">{d.sides[0].who}</p><p class="mg-says">{d.sides[0].says}</p><a class="mg-src" href={src(d.sides[0].rows)} title={tip(d.sides[0].rows)}>Source</a></div>
            <span class="mg-vs" aria-hidden="true">vs</span>
            <div class="mg-side"><p class="mg-who">{d.sides[1].who}</p><p class="mg-says">{d.sides[1].says}</p><a class="mg-src" href={src(d.sides[1].rows)} title={tip(d.sides[1].rows)}>Source</a></div>
          </div>
          {d.note && <p class="mg-dnote">{d.note.text} <a class="mg-src" href={src(d.note.rows)} title={tip(d.note.rows)}>Source</a></p>}
        </div>
      ))}
    </section>}

    <section class="mg-wrap mg-sec">
      <h2 class="mg-h"><span>{num("quotes")}</span>In their own words</h2>
      <div class="mg-quotes">
        {story.what_they_say.map((q) => (
          <figure class="mg-quote"><blockquote>{q.quote}</blockquote><figcaption>— {q.who} <a class="mg-src" href={src(q.rows)} title={tip(q.rows)}>Source</a></figcaption></figure>
        ))}
      </div>
    </section>

    <section class="mg-wrap mg-sec">
      <h2 class="mg-h"><span>{num("unknowns")}</span>Still unknown</h2>
      <ul class="mg-unknowns">
        {story.unknowns.map((u) => (<li><span aria-hidden="true">?</span><p>{u.text} <a class="mg-src" href={src(u.rows)} title={tip(u.rows)}>Source</a></p></li>))}
      </ul>
    </section>

    <section class="mg-deeper">
      <div class="mg-wrap">
        <h2 class="mg-h mg-h-inv"><span>{num("deeper")}</span>Go deeper</h2>
        <div class="mg-cards">
          <a href={`${root}/record/`}><em>Read</em><strong>The full record</strong><span>The complete account in twelve sections, every sentence tied to its sources.</span></a>
          <a href={`${root}/evidence/`}><em>Check</em><strong>The evidence</strong><span>{record.rows.length} checked facts, each with the exact quote it rests on.</span></a>
          <a href={`${root}/sources/`}><em>Trace</em><strong>The sources</strong><span>{docs === 1 ? "The document behind this case, and how far it can be trusted." : `The ${docs} documents behind this case, and how far each can be trusted.`}</span></a>
        </div>
      </div>
    </section>
  </main>
  <footer class="mg-foot"><div class="mg-wrap">Applied AI Case Study Library · {record.header.public_id} · version {record.header.version} · <a href={`${base}/`}>Back to the library</a></div></footer>
</body>
</html>

<style is:global>
  :root { --mg-ink: #0b0b0c; --mg-paper: #ffffff; --mg-soft: #f2f1ee; --mg-lime: #d2ef6b; --mg-pink: #e85a8e; --mg-violet: #4e3fd0; --mg-grey: #5f5f63;
    --mg-display: "Archivo Black", "Archivo", system-ui, sans-serif; --mg-sans: "Archivo", system-ui, sans-serif; --mg-serif: "Source Serif 4", Georgia, serif; }
  body.mg { margin: 0; background: var(--mg-paper); color: var(--mg-ink); font-family: var(--mg-serif); -webkit-font-smoothing: antialiased; }
  .mg a { color: inherit; }
  .mg-wrap { max-width: 1160px; margin: 0 auto; padding: 0 32px; }
  .mg-banner { background: var(--mg-lime); color: var(--mg-ink); text-align: center; font: 800 .72rem/1 var(--mg-sans); letter-spacing: .14em; text-transform: uppercase; padding: .55rem; }
  .mg-top { display: flex; flex-wrap: wrap; gap: .8rem 2rem; align-items: center; justify-content: space-between; max-width: 1160px; margin: 0 auto; padding: 1.1rem 32px; }
  .mg-brand { text-decoration: none; display: flex; align-items: baseline; gap: .6rem; }
  .mg-brand b { font: 400 1.25rem var(--mg-display); letter-spacing: -.02em; }
  .mg-brand span { font: 700 .7rem var(--mg-sans); letter-spacing: .16em; text-transform: uppercase; color: var(--mg-grey); }
  .mg-tabs { display: flex; gap: 1.6rem; overflow-x: auto; }
  .mg-tabs a { flex: none; font: 700 .8rem var(--mg-sans); letter-spacing: .1em; text-transform: uppercase; text-decoration: none; padding: .35rem 0; border-bottom: 3px solid transparent; }
  .mg-tabs a[aria-current] { border-bottom-color: var(--mg-pink); }
  .mg-tabs a:hover { border-bottom-color: var(--mg-ink); }

  .mg-hero { background: var(--mg-ink); color: #fff; padding: 4.5rem 0 2.2rem; position: relative; overflow: hidden; }
  .mg-hero::after { content: ""; position: absolute; right: -10%; top: -40%; width: 60%; height: 160%; background: radial-gradient(closest-side, rgb(78 63 208 / 35%), transparent); pointer-events: none; }
  .mg-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 3rem; align-items: end; position: relative; z-index: 1; }
  .mg-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 1.6rem; }
  .mg-tags span { font: 800 .7rem var(--mg-sans); letter-spacing: .14em; text-transform: uppercase; border: 1.5px solid #fff; padding: .35rem .6rem; }
  .mg-tags span:first-child { background: var(--mg-pink); border-color: var(--mg-pink); }
  .mg-hero h1 { font: 400 clamp(2.6rem, 7vw, 5.6rem)/.95 var(--mg-display); letter-spacing: -.035em; margin: 0 0 1.6rem; text-wrap: balance; }
  .mg-dek { font: 400 clamp(1.1rem, 2vw, 1.4rem)/1.5 var(--mg-serif); color: #d6d6d8; max-width: 40rem; margin: 0; }
  .mg-stamp { background: var(--mg-lime); color: var(--mg-ink); padding: 1.4rem 1.4rem 1.2rem; transform: rotate(-2deg); box-shadow: 10px 10px 0 var(--mg-pink); }
  .mg-stamp-letter { display: block; font: 400 6.5rem/.8 var(--mg-display); letter-spacing: -.05em; }
  .mg-stamp-word { display: block; font: 800 .82rem var(--mg-sans); letter-spacing: .16em; text-transform: uppercase; margin: .6rem 0 .7rem; }
  .mg-stamp p { margin: 0; font: 500 .9rem/1.45 var(--mg-sans); }
  .mg-meta { position: relative; z-index: 1; margin: 2.6rem 0 0; padding-top: 1rem; border-top: 1px solid #333; font: 700 .72rem var(--mg-sans); letter-spacing: .12em; text-transform: uppercase; color: #9a9aa0; }

  .mg-sec { padding: 4.5rem 32px 1rem; }
  .mg-h { display: flex; align-items: baseline; gap: 1rem; font: 400 clamp(1.9rem, 4vw, 3rem)/1 var(--mg-display); letter-spacing: -.03em; margin: 0 0 2.2rem; padding-top: 1rem; border-top: 6px solid var(--mg-ink); }
  .mg-h span { font: 800 .9rem var(--mg-sans); letter-spacing: .1em; color: var(--mg-pink); }
  .mg-h-inv { border-top-color: #fff; color: #fff; }
  .mg-src { font: 700 .68rem var(--mg-sans); letter-spacing: .1em; text-transform: uppercase; color: var(--mg-grey) !important; text-decoration: underline; text-decoration-color: #bdbdc2; text-underline-offset: 3px; white-space: nowrap; margin-left: .25rem; }
  .mg-src::after { content: " \2197"; }
  .mg-src:hover { color: var(--mg-violet) !important; text-decoration-color: var(--mg-violet); }
  .mg-split-sec .mg-src { color: #c4c4ca !important; text-decoration-color: #66666c; }
  .mg-split-sec .mg-src:hover { color: var(--mg-lime) !important; text-decoration-color: var(--mg-lime); }

  .mg-points { list-style: none; margin: 0; padding: 0; counter-reset: p; }
  .mg-points li { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1.2rem; padding: 1.4rem 0; border-bottom: 1px solid #ddd; }
  .mg-pn { font: 400 3.4rem/1 var(--mg-display); color: var(--mg-violet); letter-spacing: -.04em; }
  .mg-points p { margin: 0; font: 400 1.32rem/1.55 var(--mg-serif); max-width: 46rem; }

  .mg-numbers { background: var(--mg-violet); color: #fff; margin-top: 4rem; padding: 3.5rem 0; }
  .mg-num-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 2rem; }
  .mg-num { border-top: 3px solid var(--mg-lime); padding-top: 1rem; display: flex; flex-direction: column; min-width: 0; }
  .mg-num strong { display: block; font: 400 clamp(2.6rem, 5vw, 4.2rem)/1 var(--mg-display); letter-spacing: -.04em; color: var(--mg-lime); margin-bottom: .8rem; }
  .mg-num span { font: 500 1rem/1.4 var(--mg-sans); }
  .mg-num-src { margin: auto 0 0; padding-top: 1.4rem; font: 500 .7rem/1.4 var(--mg-sans); letter-spacing: .02em; color: rgb(255 255 255 / 55%); }
  .mg-num-src .mg-src { font: inherit; letter-spacing: inherit; text-transform: none; margin-left: 0; color: inherit !important; text-decoration-color: rgb(255 255 255 / 30%); }
  .mg-num-src .mg-src:hover { color: var(--mg-lime) !important; text-decoration-color: var(--mg-lime); }

  .mg-strip-wrap { overflow-x: auto; margin-bottom: 1rem; }
  .mg-strip { display: flex; border-top: 1px solid #ddd; }
  .mg-day { flex: 1 1 0; min-width: 2.2rem; border-right: 1px solid #ddd; padding: .5rem .2rem .4rem; text-align: center; font: 700 .72rem var(--mg-sans); color: var(--mg-grey); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .mg-day i { display: block; height: 2.2rem; margin-top: .4rem; background: var(--mg-soft); }
  .mg-day.mg-c-ink i { background: var(--mg-ink); } .mg-day.mg-c-grey i { background: var(--mg-grey); }
  .mg-day.mg-c-pink i { background: var(--mg-pink); } .mg-day.mg-c-violet i { background: var(--mg-violet); }
  .mg-day-gap { flex: 0 0 4rem; display: flex; align-items: center; justify-content: center; border-right-style: dashed; font-weight: 500; font-style: italic; white-space: normal; }
  .mg-key { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; margin: 0 0 2.4rem; padding: 0; list-style: none; font: 500 .85rem var(--mg-sans); color: var(--mg-grey); }
  .mg-key li { display: flex; align-items: center; gap: .45rem; }
  .mg-key i { width: .9rem; height: .9rem; display: inline-block; background: var(--mg-ink); }
  .mg-key i.mg-c-grey { background: var(--mg-grey); } .mg-key i.mg-c-pink { background: var(--mg-pink); } .mg-key i.mg-c-violet { background: var(--mg-violet); }
  .mg-tl { list-style: none; margin: 1.4rem 0 0; padding: 0 0 0 1.6rem; border-left: 3px solid var(--mg-ink); max-width: 46rem; }
  .mg-tl li { position: relative; }
  .mg-tl time { position: relative; display: block; font: 400 1.6rem/1.2 var(--mg-display); letter-spacing: -.03em; }
  .mg-tl time::before { content: ""; position: absolute; left: calc(-1.6rem - 8px); top: .45rem; width: 13px; height: 13px; border-radius: 50%; background: var(--mg-paper); border: 3px solid var(--mg-ink); box-sizing: border-box; }
  .mg-tl li.mg-c-pink time { color: var(--mg-pink); } .mg-tl li.mg-c-pink time::before { background: var(--mg-pink); border-color: var(--mg-pink); }
  .mg-tl li.mg-c-violet time { color: var(--mg-violet); } .mg-tl li.mg-c-violet time::before { background: var(--mg-violet); border-color: var(--mg-violet); }
  .mg-tl li.mg-c-grey time::before { background: var(--mg-grey); border-color: var(--mg-grey); }
  .mg-tl li.mg-c-ink time::before { background: var(--mg-ink); }
  .mg-tl p { margin: .2rem 0 0; font: 400 1.12rem/1.5 var(--mg-serif); }
