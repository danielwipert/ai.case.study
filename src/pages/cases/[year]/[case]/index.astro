---
// The reader layer ("the story"), in the library style of 2026-10-24: a
// colour field per subject, serif type, numbers and dates as exhibits. Plain
// English; every statement tied to checked rows; detail one and two clicks down.
import "../../../../styles/library.css";
import { getCollection } from "astro:content";
import { load as parseYaml } from "js-yaml";
import { createHash } from "node:crypto";
import fs from "node:fs";
import path from "node:path";
import { loadCase, shortCode } from "../../../../record/lib/record.mjs";
import { recordRoutes } from "../../../../record/lib/routes.mjs";
import { THEMES, themeOf } from "../../../../record/subjects.mjs";
import FeatureExhibit from "../../../../components/FeatureExhibit.astro";

export function getStaticPaths() {
  return recordRoutes();
}

const stories = import.meta.glob("../../../../record/cases/*/story.yaml", { query: "?raw", import: "default", eager: true });
const code = Astro.props.code;
const story = parseYaml(stories[`../../../../record/cases/${code}/story.yaml`]);
const record = loadCase(code);
const byShort = new Map(record.rows.map((r) => [shortCode(r.code), r]));
for (const list of [[story.grade], ...(story.dek_rows ? [[{ rows: story.dek_rows }]] : []), story.short_version, story.numbers, story.timeline, story.what_they_say, story.unknowns, ...(story.disagreements ?? []).map((d) => [...d.sides, ...(d.note ? [d.note] : [])])])
  for (const item of list) for (const r of item.rows) if (!byShort.has(r)) throw new Error(`story.yaml cites ${r}, which is not a live row`);

// The feature (feature.yaml, optional): the long-form explanation in chapters with exhibits, below the short
// version. Every paragraph and exhibit item cites live rows; only the library's reading may open with a
// paragraph that cites none (its framing sentence).
const features = import.meta.glob("../../../../record/cases/*/feature.yaml", { query: "?raw", import: "default", eager: true });
const featureRaw = features[`../../../../record/cases/${code}/feature.yaml`];
const feature = featureRaw ? parseYaml(featureRaw) : null;
if (feature) {
  const cite = (where, rows, emptyOk = false) => {
    if (!Array.isArray(rows) || (!rows.length && !emptyOk)) throw new Error(`feature.yaml: ${where} cites no rows`);
    for (const r of rows) if (!byShort.has(r)) throw new Error(`feature.yaml: ${where} cites ${r}, which is not a live row`);
  };
  for (const side of ["before", "after"]) for (const it of feature.in_context?.[side] ?? []) cite(`in_context.${side}`, it.rows);
  feature.chapters.forEach((c, i) => {
    c.paras.forEach((p, j) => cite(`chapter ${i + 1} paragraph ${j + 1}`, p.rows, c.reading && j === 0));
    const ex = c.exhibit;
    if (!ex) return;
    if (!["figures", "lanes", "table", "bars"].includes(ex.kind)) throw new Error(`feature.yaml: chapter ${i + 1} exhibit kind "${ex.kind}" is unknown`);
    for (const it of ex.items ?? ex.rows_data) cite(`chapter ${i + 1} exhibit`, it.rows);
  });
}
const chapters = (feature?.chapters ?? []).filter((c) => !c.reading);
// Each chapter lists its checked facts once, at its end, in order of first use (Dan, 2026-10-25: per-paragraph
// source links broke up the flow).
const chapterFacts = (c) => [...new Set([...c.paras.flatMap((p) => p.rows), ...((c.exhibit?.items ?? c.exhibit?.rows_data ?? []).flatMap((it) => it.rows))])]
  .map((r) => ({ code: r, href: `${root}/evidence/#${r}`, row: byShort.get(r) }));
const readings = (feature?.chapters ?? []).filter((c) => c.reading);
// The story's own numbers exhibit gives way to a feature that draws its own figures.
const showNumbers = !chapters.some((c) => c.exhibit?.kind === "figures");
const exhibitNo = new Map();
for (const c of chapters) if (c.exhibit) exhibitNo.set(c, exhibitNo.size + 1);
const numbersNo = exhibitNo.size + 1;
const timelineNo = numbersNo + (showNumbers ? 1 : 0);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const root = `${base}/cases/${Astro.params.year}/${Astro.params.case}`;
const tip = (rows) => rows.map((r) => `${r}: ${byShort.get(r).statement} [${byShort.get(r).label.display}]`).join("\n\n");
const src = (rows) => `${root}/evidence/#${rows[0]}`;
const docs = record.documents.length;

// The one-page summary PDF (public/onepagers/), made in the private repo by tools/onepager.py.
// Shown only when the case has one; the build warns when the story changed after the PDF was made.
const onepagerManifest = (() => {
  try { return JSON.parse(fs.readFileSync(path.join(process.cwd(), "public/onepagers/manifest.json"), "utf8")); } catch { return {}; }
})();
const onepager = onepagerManifest[code] ?? null;
const onepagerHref = onepager ? `${base}/onepagers/${onepager.pdf}` : null;
if (onepager) {
  const storySha = createHash("sha256").update(stories[`../../../../record/cases/${code}/story.yaml`]).digest("hex");
  if (storySha !== onepager.story_sha256) console.warn(`[onepager] ${code}: story.yaml changed after the one-page summary was made; rebuild it with tools/onepager.py`);
}
const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;
// Section numbers follow the sections a story actually has.
const order = ["short", ...chapters.map((_, i) => `ch${i}`), ...(story.disagreements?.length ? ["disagree"] : []), "quotes", "unknowns", ...readings.map((_, i) => `rd${i}`), "deeper"];
const num = (key) => order.indexOf(key) + 1;
const pad = (n) => String(n).padStart(2, "0");

// Timeline marks: an entry may name a `mark` from `timeline_key`, which gives it a colour and a legend line.
// Colour follows the event, never its position in the list. The names predate the redesign: pink is now the
// case's subject colour, violet a deeper shade of it, grey and ink stay neutral.
const MARK_COLORS = new Set(["pink", "violet", "grey", "ink"]);
const key = story.timeline_key ?? [];
for (const k of key) if (!MARK_COLORS.has(k.color)) throw new Error(`timeline_key colour "${k.color}" is not one of ${[...MARK_COLORS].join(", ")}`);
const markColor = new Map(key.map((k) => [k.mark, k.color]));
for (const t of story.timeline) if (t.mark && !markColor.has(t.mark)) throw new Error(`timeline mark "${t.mark}" is not in timeline_key`);
const colorOf = (t) => (t.mark ? markColor.get(t.mark) : null);

// Timeline to scale: parse "8 Jul", "Sep 2024" or "6 Apr 2026". A date without a year takes the previous
// entry's year (or the story's), moving to the next year if the month goes backwards.
// Any date that does not parse turns the scaling off and the list renders as before.
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const DAY = 86400000;
const storyYear = Number(`${story.tags.join(" ")} ${story.checked}`.match(/\b(?:19|20)\d{2}\b/)?.[0] ?? new Date().getFullYear());
const parsed = (() => {
  let year = null, month = null;
  const out = [];
  for (const t of story.timeline) {
    const m = String(t.date).trim().match(/^(?:(\d{1,2}) )?([A-Z][a-z]{2})[a-z]* ?(\d{4})?$/);
    if (!m || !MONTHS.includes(m[2])) return null;
    const mo = MONTHS.indexOf(m[2]);
    const y = m[3] ? Number(m[3]) : year === null ? storyYear : year + (mo < month ? 1 : 0);
    year = y; month = mo;
    out.push({ day: m[1] ? Number(m[1]) : null, month: mo, year: y, ms: Date.UTC(y, mo, m[1] ? Number(m[1]) : 1) });
  }
  return out;
})();
const gaps = parsed ? parsed.map((d, i) => {
  if (i === 0) return null;
  const p = parsed[i - 1];
  if (d.day !== null && p.day !== null) {
    const days = Math.round((d.ms - p.ms) / DAY);
    return { approxDays: days, text: days === 0 ? "Same day" : days === 1 ? "Next day" : `${days} days` };
  }
  const months = (d.year - p.year) * 12 + d.month - p.month;
  return { approxDays: months * 30.4, text: months === 0 ? "Same month" : months === 1 ? "1 month" : `${months} months` };
}) : [];
// A gap far longer than the typical one is drawn as a break; the rest get space in proportion to their length.
const spans = gaps.filter(Boolean).map((g) => g.approxDays).sort((a, b) => a - b);
const median = spans.length ? (spans[(spans.length - 1) >> 1] + spans[spans.length >> 1]) / 2 : 0;
const isBreak = (g) => g && g.approxDays > 14 && g.approxDays > 4 * median;
const longest = Math.max(1, ...gaps.filter((g) => g && !isBreak(g)).map((g) => g.approxDays));
const gapPad = (g) => `${(0.6 + 1.2 * (g.approxDays / longest)).toFixed(2)}rem`;

// The calendar strip: one square per day, drawn only for short, day-precise timelines (a month of days or less, breaks aside).
const strip = (() => {
  if (!parsed || parsed.some((d) => d.day === null)) return null;
  const segments = [];
  parsed.forEach((d, i) => {
    if (i === 0 || isBreak(gaps[i])) segments.push({ from: d.ms, to: d.ms, gap: i === 0 ? null : gaps[i].text });
    else segments[segments.length - 1].to = d.ms;
  });
  const cells = segments.reduce((n, s) => n + (s.to - s.from) / DAY + 1, 0);
  if (cells > 31) return null;
  const byDay = new Map();
  parsed.forEach((d, i) => { if (!byDay.has(d.ms) || colorOf(story.timeline[i])) byDay.set(d.ms, colorOf(story.timeline[i]) ?? "ink"); });
  return segments.map((s) => ({
    gap: s.gap,
    days: Array.from({ length: (s.to - s.from) / DAY + 1 }, (_, k) => {
      const ms = s.from + k * DAY, dt = new Date(ms);
      return { label: k === 0 ? `${dt.getUTCDate()} ${MONTHS[dt.getUTCMonth()]}` : String(dt.getUTCDate()), color: byDay.get(ms) ?? null };
    }),
  }));
})();
const first = story.timeline[0].date, last = story.timeline[story.timeline.length - 1].date;

// The theme colour, the hero figure (the story's first number) and the related cases.
const subj = themeOf(record.header.public_id);
const hero = story.numbers[0];
const caseNo = record.header.public_id.slice(-3);
const entries = await getCollection("cases", ({ data }) => ["published", "archived"].includes(data.status));
const self = entries.find((e) => e.data.case_id === record.header.public_id);
const related = (self?.data.related_cases ?? [])
  .map((id) => entries.find((e) => e.data.case_id === id))
  .filter(Boolean)
  .map((e) => {
    const t = themeOf(e.data.case_id);
    return { href: `${base}/cases/${e.id}/`, title: e.data.title, subj: t, label: `${THEMES[t]} · Case ${e.data.case_id.slice(-3)}` };
  });
const docTitles = record.documents.map((d) => d.title);
const cutoff = record.header.charter?.evidence_cutoff;
const longDate = (d) => d ? new Date(`${d}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }) : null;
const pageUrl = Astro.site ? new URL(`${root}/`, Astro.site).href : `${root}/`;
const citation = `Applied AI Case Study Library. \u201c${story.headline}.\u201d Case ${record.header.public_id}, version ${record.header.version}, ${story.checked}. ${pageUrl}`;
const [lede, ...points] = story.short_version;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={story.dek} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <title>{story.headline} | Applied AI Case Study Library</title>
</head>
<body class="lb" data-subj={subj}>
  <header class="lb-wrap">
    <div class="lb-mast">
      <a class="lb-brand" href={`${base}/`}><b>Applied AI</b><span>Case Study Library</span></a>
      <nav class="lb-tabs" aria-label="Layers of this case">
        <a aria-current="page" href={`${root}/`}>The story</a>
        <a href={`${root}/record/`}>Full record</a>
        <a href={`${root}/evidence/`}>Evidence</a>
        <a href={`${root}/sources/`}>Sources</a>
        {onepagerHref && <a class="lb-dl" href={onepagerHref} download>One-page summary <span>PDF</span></a>}
      </nav>
    </div>
    <div class="lb-strip" aria-hidden="true">{Object.keys(THEMES).map((t) => <i data-subj={t}></i>)}</div>
  </header>

  <main class="lb-wrap">
    <div class="cs-opener">
      <div class="cs-field">
        <p class="cs-field-top"><span>{THEMES[subj]}</span><span>Case {caseNo}</span></p>
        <div class="cs-field-fig">
          <strong>{hero.figure}</strong>
          <span>{hero.label}</span>
          <a class="cs-src" href={src(hero.rows)} title={tip(hero.rows)}>Source</a>
        </div>
      </div>
      <div class="cs-head">
        <p class="cs-kicker">{story.tags.join(" · ")}</p>
        <h1>{story.headline}</h1>
        <p class="cs-standfirst">{story.dek}</p>
        <p class="cs-byline">
          <span><b>Evidence grade {story.grade.letter}</b>, {story.grade.plain.toLowerCase()}</span>
          <span>{story.checked[0].toUpperCase() + story.checked.slice(1)}</span>
          <span>{record.header.public_id} · version {record.header.version}</span>
          <span>{plural(docs, "public source", "public sources")}</span>
        </p>
      </div>
    </div>

    <div class="cs-body">
      <article class="cs-col">
        <section>
          <div class="cs-sec"><span class="cs-n">{num("short")}</span><h2>The short version</h2></div>
          <p class="cs-lede">{lede.text} <a class="cs-src" href={src(lede.rows)} title={tip(lede.rows)}>Source</a></p>
          {points.length > 0 && (
            <ol class="cs-points">
              {points.map((p) => (<li><p>{p.text} <a class="cs-src" href={src(p.rows)} title={tip(p.rows)}>Source</a></p></li>))}
            </ol>
          )}
        </section>

        {chapters.map((c, i) => (
          <section class="cs-chapter">
            <div class="cs-sec"><span class="cs-n">{num(`ch${i}`)}</span><h2>{c.title}</h2></div>
            {c.paras.map((p) => (<p class="cs-para">{p.text}</p>))}
            {c.exhibit && <FeatureExhibit exhibit={c.exhibit} n={exhibitNo.get(c)} src={src} tip={tip} links={false} />}
            <details class="cs-facts">
              <summary>Facts checked in this section <span>({chapterFacts(c).length})</span></summary>
              <ol>{chapterFacts(c).map((f) => <li><a href={f.href}>{f.code}</a> {f.row.statement} <span class="cs-facts-label">{f.row.label.display}</span></li>)}</ol>
            </details>
          </section>
        ))}

        {showNumbers && (
          <figure class="cs-ex" aria-labelledby="ex-numbers">
            <figcaption id="ex-numbers"><b>Exhibit {numbersNo}</b><span>The numbers</span></figcaption>
            <div class="cs-figs">
              {story.numbers.map((n) => (
                <div class="cs-fig"><strong>{n.figure}</strong><span>{n.label}</span><p class="cs-fig-src">{n.by && `Counted by ${n.by} · `}<a class="cs-src" href={src(n.rows)} title={tip(n.rows)}>Source</a></p></div>
              ))}
            </div>
          </figure>
        )}

        <figure class="cs-ex" aria-labelledby="ex-timeline">
          <figcaption id="ex-timeline"><b>Exhibit {timelineNo}</b><span>{story.timeline_title ?? "Day by day"}</span></figcaption>
          {strip && (
            <div class="cs-strip-wrap" role="img" aria-label={`Calendar from ${first} to ${last}, one square per day. Filled squares are the days in the list below.`}>
              <div class="cs-cal">
                {strip.map((seg) => (<>
                  {seg.gap && <div class="cs-day cs-day-gap">{seg.gap}</div>}
                  {seg.days.map((d) => <div class={`cs-day${d.color ? ` c-${d.color}` : ""}`}>{d.label}<i></i></div>)}
                </>))}
              </div>
            </div>
          )}
          {key.length > 0 && (
            <ul class="cs-key">{key.map((k) => <li><i class={`c-${k.color}`}></i>{k.label}</li>)}</ul>
          )}
          <ol class="cs-tl">
            {story.timeline.map((t, i) => (
              <li class={colorOf(t) ? `c-${colorOf(t)}` : undefined}>
                {gaps[i] && (isBreak(gaps[i])
                  ? <p class="cs-gap cs-gap-break" aria-hidden="true">{gaps[i].text}</p>
                  : <p class="cs-gap" style={`padding-block: ${gapPad(gaps[i])}`} aria-hidden="true">{gaps[i].text}</p>)}
                <time>{t.date}</time><p>{t.text} <a class="cs-src" href={src(t.rows)} title={tip(t.rows)}>Source</a></p>
              </li>
            ))}
          </ol>
        </figure>

        {story.disagreements?.length > 0 && (
          <section>
            <div class="cs-sec"><span class="cs-n">{num("disagree")}</span><h2>{story.disagreements_title ?? "Where the accounts disagree"}</h2></div>
            <p class="cs-intro">{story.disagreements_lede ?? "Both sides, side by side. We don't pick one: the public record doesn't settle it."}</p>
            {story.disagreements.map((d) => (
              <div class="cs-dis">
                <h3>{d.title}</h3>
                <div class="cs-sides">
                  {d.sides.map((side) => (
                    <div class="cs-side"><p class="lb-label">{side.who}</p><p>{side.says}</p><a class="cs-src" href={src(side.rows)} title={tip(side.rows)}>Source</a></div>
                  ))}
                </div>
                {d.note && <p class="cs-note">{d.note.text} <a class="cs-src" href={src(d.note.rows)} title={tip(d.note.rows)}>Source</a></p>}
              </div>
            ))}
          </section>
        )}

        <section>
          <div class="cs-sec"><span class="cs-n">{num("quotes")}</span><h2>In their own words</h2></div>
          <div class="cs-quotes">
            {story.what_they_say.map((q) => (
              <figure class="cs-quote"><blockquote>{q.quote}</blockquote><figcaption>{q.who} <a class="cs-src" href={src(q.rows)} title={tip(q.rows)}>Source</a></figcaption></figure>
            ))}
          </div>
        </section>

        <section>
          <div class="cs-sec"><span class="cs-n">{num("unknowns")}</span><h2>Still unknown</h2></div>
          <ul class="cs-unknowns">
            {story.unknowns.map((u) => (<li><span aria-hidden="true">?</span><p>{u.text} <a class="cs-src" href={src(u.rows)} title={tip(u.rows)}>Source</a></p></li>))}
          </ul>
        </section>

        {readings.map((c, i) => (
          <section class="cs-reading">
            <div class="cs-sec"><span class="cs-n">{num(`rd${i}`)}</span><h2>{c.title}</h2></div>
            <p class="cs-reading-label">The library's reading</p>
            {c.paras.map((p) => (<p class="cs-para">{p.text}</p>))}
            <details class="cs-facts">
              <summary>Facts checked in this section <span>({chapterFacts(c).length})</span></summary>
              <ol>{chapterFacts(c).map((f) => <li><a href={f.href}>{f.code}</a> {f.row.statement} <span class="cs-facts-label">{f.row.label.display}</span></li>)}</ol>
            </details>
          </section>
        ))}

        <section>
          <div class="cs-sec"><span class="cs-n">{num("deeper")}</span><h2>Go deeper</h2></div>
          <div class="cs-deeper">
            <a href={`${root}/record/`}><em>Read</em><strong>The full record</strong><span>The complete account in twelve sections, every sentence tied to its sources.</span></a>
            <a href={`${root}/evidence/`}><em>Check</em><strong>The evidence</strong><span>{record.rows.length} checked facts, each with the exact quote it rests on.</span></a>
            <a href={`${root}/sources/`}><em>Trace</em><strong>The sources</strong><span>{docs === 1 ? "The document behind this case, and how far it can be trusted." : `The ${docs} documents behind this case, and how far each can be trusted.`}</span></a>
          </div>
          {onepagerHref && <p class="cs-dl-row"><a class="lb-dl" href={onepagerHref} download>Download the one-page summary <span>PDF</span></a><span>The case on one page, to print or share.</span></p>}
        </section>

        {related.length > 0 && (
          <nav class="cs-seealso" aria-label="See also">
            <p class="lb-label">See also</p>
            <div class="cs-chips">
              {related.map((r) => (<a class="cs-chip" data-subj={r.subj} href={r.href}><span class="lb-label">{r.label}</span><span>{r.title}</span></a>))}
            </div>
          </nav>
        )}

        <div class="cs-cite">
          <p class="lb-label">How to cite this case</p>
          <p id="cs-cite-text">{citation}</p>
          <button type="button" id="cs-cite-copy" hidden>Copy citation</button>
        </div>
      </article>

      <aside class="cs-rail" aria-label="In context">
        <div class="cs-context">
          <h2>In context</h2>
          <dl>
            <dt>Theme</dt>
            <dd>{THEMES[subj]}</dd>
            {feature?.in_context?.before?.length > 0 && <><dt>Before</dt>{feature.in_context.before.map((it) => <dd>{it.text} <a class="cs-src" href={src(it.rows)} title={tip(it.rows)}>Source</a></dd>)}</>}
            {feature?.in_context?.after?.length > 0 && <><dt>After</dt>{feature.in_context.after.map((it) => <dd>{it.text} <a class="cs-src" href={src(it.rows)} title={tip(it.rows)}>Source</a></dd>)}</>}
            <dt>{docs === 1 ? "The source read" : `The ${docs} sources read`}</dt>
            {docTitles.map((t) => <dd>{t}</dd>)}
            <dt>Period covered</dt>
            <dd>{first} to {last}</dd>
            {cutoff && <><dt>Evidence cutoff</dt><dd>{longDate(cutoff)}</dd></>}
            <dt>Checked</dt>
            <dd>{story.checked.replace(/^checked /, "")}, version {record.header.version}</dd>
          </dl>
        </div>
        <div class="cs-grade">
          <span class="cs-grade-letter">{story.grade.letter}</span>
          <span class="lb-label">Evidence grade</span>
          <b>{story.grade.plain}</b>
          <p>{story.grade.explain} <a class="cs-src" href={src(story.grade.rows)} title={tip(story.grade.rows)}>Source</a></p>
        </div>
      </aside>
    </div>
  </main>

  <footer class="lb-foot"><div class="lb-wrap"><span>Applied AI Case Study Library · {record.header.public_id} · version {record.header.version}</span><a href={`${base}/`}>Back to the library</a></div></footer>

  <script>
    // Copy the citation; the button stays hidden where the clipboard is unavailable.
    const btn = document.getElementById("cs-cite-copy");
    const text = document.getElementById("cs-cite-text");
    if (btn && text && navigator.clipboard) {
      btn.hidden = false;
      btn.addEventListener("click", () => {
        navigator.clipboard.writeText(text.textContent ?? "").then(() => {
          btn.textContent = "Copied";
          setTimeout(() => { btn.textContent = "Copy citation"; }, 1600);
        }, () => {});
      });
    }
  </script>
</body>
</html>

<style is:global>
  /* Opener: the subject's colour field with the story's lead figure, beside the headline */
  .cs-opener { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); margin-top: 2rem; }
  .cs-field { background: var(--pop); color: var(--pop-on); padding: 1.6rem 1.8rem 1.8rem; display: grid; align-content: space-between; gap: 2.5rem; min-height: 22rem; }
