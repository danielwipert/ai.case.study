---
// The page shell in the library style: masthead with the main menu, the theme
// strip, and footer. Used by the home page, Explore and Methodology; the case
// pages have their own shells.
import "../styles/library.css";
import { THEMES } from "../record/subjects.mjs";

interface Props {
  title?: string;
  description?: string;
  active?: "explore" | "methodology";
}

const {
  title = "Applied AI Case Study Library",
  description = "Evidence-first cases about how AI changes real organizations, work, economics, and risk.",
  active
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const menu = [
  { key: "explore", label: "Explore cases", href: `${base}/explore/` },
  { key: "methodology", label: "Methodology", href: `${base}/methodology/` }
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <title>{title}</title>
</head>
<body class="lb">
  <a class="lb-skip" href="#main">Skip to content</a>
  <header class="lb-wrap">
    <div class="lb-mast">
      <a class="lb-brand" href={`${base}/`}><b>Applied AI</b><span>Case Study Library</span></a>
      <nav class="lb-tabs" aria-label="Main navigation">
        {menu.map((item) => <a href={item.href} aria-current={item.key === active ? "page" : undefined}>{item.label}</a>)}
        <a href="https://github.com/danielwipert/ai.case.study">Contribute ↗</a>
      </nav>
    </div>
    <div class="lb-strip" aria-hidden="true">{Object.keys(THEMES).map((t) => <i data-subj={t}></i>)}</div>
  </header>

  <main id="main"><slot /></main>

  <footer class="lb-foot">
    <div class="lb-wrap">
      <span>An open, evidence-first record of AI in practice.</span>
      <a href="https://github.com/danielwipert/ai.case.study">Source and revision history ↗</a>
    </div>
  </footer>
</body>
</html>
